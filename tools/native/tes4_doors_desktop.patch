+        door["hasSequence"] = [](const Object& object, std::string name) {
+            const auto* animation = MWBase::Environment::get().getWorld()->getAnimation(door4Ptr(object));
+            return animation && animation->hasAnimation(Misc::StringUtils::lowerCase(name));
+        };
+        door["isSequencePlaying"] = [](const Object& object, std::string name) {
+            const auto* animation = MWBase::Environment::get().getWorld()->getAnimation(door4Ptr(object));
+            return animation && animation->isPlaying(Misc::StringUtils::lowerCase(name));
+        };
+        door["playSequence"] = [context](const Object& object, std::string name) {
+            if (!object.isGObject()) throw std::runtime_error("Door sequences require a global script");
+            const auto& ptr = door4Ptr(object);
+            if (ptr.getCellRef().getTeleport() || !ptr.getRefData().isEnabled() || name.empty() || name.size() > 128)
+                return false;
+            name = Misc::StringUtils::lowerCase(name);
+            const auto* animation = MWBase::Environment::get().getWorld()->getAnimation(ptr);
+            if (!animation || !animation->hasAnimation(name)) return false;
+            context.mLuaManager->addAction([object = Object(object), name = std::move(name)] {
+                const auto& current = door4Ptr(object);
+                if (current.getRefData().isEnabled())
+                {
+                    const bool started = MWBase::Environment::get().getMechanicsManager()->playAnimationGroupLua(
+                        current, name, 0, 1.f, "start", "stop", false);
+                    Log(Debug::Info) << "OPENOBLIVION_DOOR_SEQUENCE name=" << name << " started=" << started;
+                }
+            }, "TES4DoorSequence");
+            return true;
+        };
         door["isTeleport"] = [](const Object& o) { return door4Ptr(o).getCellRef().getTeleport(); };
         door["destPosition"]
             = [](const Object& o) -> osg::Vec3f { return door4Ptr(o).getCellRef().getDoorDest().asVec3(); };
